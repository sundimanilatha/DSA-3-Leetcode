class Solution {
    public int countGoodNumbers(long n) {
        long mod = 1000000007;
        long even = (n + 1) / 2;
        long odd = n / 2;
        return (int) ((power(5, even, mod) * power(4, odd, mod)) % mod);
    }
    public long power(long x, long n, long mod) {
        long ans = 1;
        while(n > 0) {
            if(n % 2 == 1) {
                ans = (ans * x)% mod;
            }
            x = (x * x)% mod;
            n /=2;
        }
        return ans;
    }
}
